PORT=8080
REMOTE_TIMEOUT_MS=60000

# Existing DingTalk backend
DINGTALK_UPLOAD_URL=https://h5.dingtalk.com/common/picUpload
DINGTALK_COOKIE=
DINGTALK_TOKEN=

# Browser -> third-party upload -> URL -> Node -> DingTalk
REMOTE_CHUNK_PREFIX_BYTES=125
REMOTE_CHUNK_UPLOAD_URL=https://i.snssdk.com/feedback/image/v1/upload/?appkey=aweme-web&aid=1128&app_name=aweme
REMOTE_SOURCE_HOST_SUFFIX=byteimg.com

# Playback cache
PREFETCH_CONCURRENCY=2
REMOTE_CONCURRENCY=4

# S3-compatible facade (backend remains DingTalk)
S3_BUCKET=video
S3_ACCESS_KEY=node2-access
S3_SECRET_KEY=change-this-secret
S3_REGION=us-east-1

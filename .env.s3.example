# Existing settings
PORT=8080
REMOTE_TIMEOUT_MS=60000
DINGTALK_UPLOAD_URL=https://h5.dingtalk.com/common/picUpload
DINGTALK_COOKIE=
DINGTALK_TOKEN=

# S3-compatible Gateway (NOT S3 storage)
# The Node server still uses the existing DingTalk-backed storage internally.
S3_BUCKET=video
S3_ACCESS_KEY=node2-access
S3_SECRET_KEY=replace-with-a-long-random-secret
S3_REGION=us-east-1

# Existing playback cache
# These are already built into server.js:
# 64 MiB memory LRU
# 1 GiB disk LRU
# 50 MiB prefetch
# shared in-flight chunk merge
# multi-user shared cache
